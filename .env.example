# --- copy to .env and fill in ---
# Local development runs without Docker: PostgreSQL and Redis are started by
#   scripts/services.sh start
# MedGemma runs on a separate GPU machine and is reached over its ngrok URL.

DATABASE_URL=postgresql+psycopg://nazar:nazar@localhost:5432/nazar
REDIS_URL=redis://localhost:6379/0
STORAGE_PATH=storage
RULES_PATH=rules/triage.yaml
DEMO_DATA_PATH=demo-data

# Use a long random value: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# Report generator (cloud LLM). Patient names are never sent.
LLM_PROVIDER=anthropic          # anthropic | gemini | medgemma
LLM_API_KEY=

# MedGemma 1.5 service on the GPU machine, published with ngrok.
# Example: https://nazar-gpu.ngrok-free.app  (no trailing slash)
MEDGEMMA_URL=http://localhost:8001
MEDGEMMA_MODEL=google/medgemma-1.5-4b-it
MEDGEMMA_STUB=true              # true until the GPU box is reachable: cached JSON from demo-data/
HF_TOKEN=                       # needed to download gated MedGemma weights

# Optional second reader for head CT (leave empty if weights are not available)
ICH_WEIGHTS_PATH=
