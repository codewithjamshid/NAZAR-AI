# --- copy to .env and fill in ---
# Local development runs without Docker: PostgreSQL and Redis are started by
#   scripts/services.sh start
# MedGemma runs on a separate GPU machine and is reached over its ngrok URL.

DATABASE_URL=postgresql+psycopg://nazar:nazar@localhost:5432/nazar
REDIS_URL=redis://localhost:6379/0
STORAGE_PATH=storage
RULES_PATH=rules/triage.yaml
DEMO_DATA_PATH=demo-data

# Use a long random value: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=12

# Report generator (cloud LLM). Patient names are never sent; the call runs in
# the worker after triage, and any draft that names a diagnosis, drug or
# procedure the input never mentioned is thrown away in favour of the template.
LLM_PROVIDER=gemini             # gemini | anthropic
LLM_API_KEY=                    # empty -> the deterministic Uzbek template is used
# Comma-separated list: on HTTP 429 the next model is tried. Gemini's free tier
# is per model and small (measured 18.09.2026: 20 requests/day for 2.5-flash),
# so listing two models doubles the daily budget. Empty -> provider default.
LLM_MODEL=gemini-3.1-flash-lite,gemini-2.5-flash

# MedGemma 1.5 service on the GPU machine, published with ngrok.
# Example: https://nazar-gpu.ngrok-free.app  (no trailing slash)
MEDGEMMA_URL=http://localhost:8001
MEDGEMMA_API_KEY=               # sent as X-API-Key; set the same value on the GPU box
MEDGEMMA_MODEL=google/medgemma-1.5-4b-it
MEDGEMMA_STUB=true              # true until the GPU box is reachable: cached JSON from demo-data/
MEDGEMMA_CT_SLICES=16           # slices sent per head CT; lower it if the GPU box is slow (TZ §15 R4)
CT_VIEWER_MAX_SLICES=200        # slice PNGs kept for the panel viewer
HF_TOKEN=                       # needed to download gated MedGemma weights

# Optional second reader for head CT (leave empty if weights are not available)
ICH_WEIGHTS_PATH=

# Uzbek speech to text (voice anamnesis, TZ §7 M2).
#   gemini  - strong on Uzbek; the AUDIO IS SENT TO GOOGLE. The nurse app asks
#             nurses not to say the patient's name and the name is scrubbed
#             from the transcript, but the recording itself leaves the building.
#   whisper - local faster-whisper, nothing leaves (install: uv pip install faster-whisper)
STT_PROVIDER=gemini
STT_MODEL=gemini-3.1-flash-lite,gemini-3.5-flash   # tried in order on 429/503
STT_API_KEY=                    # empty -> LLM_API_KEY
WHISPER_MODEL=small
STT_LANGUAGE=uz

# Browsers that may call the API (comma separated, or * for local development)
CORS_ORIGINS=*
